---
interface Props {
  title: string;
  company: string;
  status: string;
  image?: string;
  video?: string;
  href?: string;
  description?: string;
  featured?: boolean;
  cursorText?: string;
}

const { title, company, status, image, video, href, description, featured = false, cursorText = "VIEW PROJECT" } = Astro.props;
---

{href ? (
  <a href={href} class:list={["project-card", { featured }]} data-cursor-text={cursorText}>
    <div class="project-image">
      {video ? (
        <video src={video} autoplay loop muted playsinline />
      ) : (
        <img src={image} alt={title} loading="lazy" />
      )}
    </div>
    <div class="project-info">
      <div class="project-meta">
        <span class="project-title">{title}</span>
        <span class="project-company">{company} · {status}</span>
      </div>
    </div>
  </a>
) : (
  <div class:list={["project-card", { featured }]} data-cursor-text={cursorText}>
    <div class="project-image">
      {video ? (
        <video src={video} autoplay loop muted playsinline />
      ) : (
        <img src={image} alt={title} loading="lazy" />
      )}
    </div>
    <div class="project-info">
      <div class="project-meta">
        <span class="project-title">{title}</span>
        <span class="project-company">{company} · {status}</span>
      </div>
    </div>
  </div>
)}

<style>
  .project-card {
    display: block;
    background: transparent;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: none;
    cursor: none;
  }

  .project-image {
    overflow: hidden;
    background: transparent;
  }

  .project-image img,
  .project-image video {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  .project-image {
    position: relative;
  }

  .project-image::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(0, 0, 0, 0.15);
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .project-info {
    padding: 0.75rem 0 0.5rem 0;
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 600;
    text-wrap: balance;
  }

  .project-company {
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.8rem;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

</style>
