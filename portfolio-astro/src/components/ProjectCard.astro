---
interface Props {
  title: string;
  company: string;
  status: string;
  image: string;
  href: string;
  description?: string;
  featured?: boolean;
}

const { title, company, status, image, href, description, featured = false } = Astro.props;
---

<a href={href} class:list={["project-card", { featured }]}>
  <div class="project-image">
    <img src={image} alt={title} loading="lazy" />
  </div>
  <div class="project-info">
    <div class="project-meta">
      <span class="project-title">{title}</span>
      <span class="project-company">{company}, {status}</span>
    </div>
    {description && (
      <p class="project-description">{description}</p>
    )}
  </div>
</a>

<style>
  .project-card {
    display: block;
    background: var(--color-surface);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    cursor: none;
  }

  .project-image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #ddd;
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-info {
    padding: var(--spacing-md);
  }

  .project-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .project-title {
    font-size: 1.25rem;
    font-weight: 500;
  }

  .project-company {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
  }

  .project-description {
    margin-top: var(--spacing-sm);
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }

  /* Featured card style - same title size for consistency */
  .featured .project-image {
    aspect-ratio: 4 / 3;
  }
</style>
