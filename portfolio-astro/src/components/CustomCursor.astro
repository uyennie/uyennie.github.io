---

<div class="cursor" id="cursor">
  <div class="cursor-shape">
    <span class="cursor-text">VIEW PROJECT</span>
  </div>
</div>

<style>
  .cursor {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
  }

  .cursor-shape {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-width: 18px;
    height: 18px;
    padding: 0 9px;
    background: #15FC00;
    border-radius: 9999px;
    transform: translateY(-50%);
    transform-origin: left center;
    transition: 
      all 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .cursor-text {
    font-family: 'SF Mono', 'Fira Code', 'Monaco', 'Consolas', 'Liberation Mono', 'Courier New', monospace;
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    white-space: nowrap;
    color: #484848;
    opacity: 0;
    max-width: 0;
    overflow: hidden;
    transition: 
      max-width 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 0.25s ease;
  }

  /* Hover state - morph into pill */
  .cursor.hovering .cursor-shape {
    height: 32px;
    padding: 0 14px;
  }

  .cursor.hovering .cursor-text {
    opacity: 1;
    max-width: 200px;
  }

  /* Hide on touch devices */
  @media (hover: none) {
    .cursor {
      display: none;
    }
  }
</style>

<script>
  const cursor = document.getElementById('cursor');
  const cursorText = cursor?.querySelector('.cursor-text');
  
  if (cursor) {
    // Track mouse position
    document.addEventListener('mousemove', (e) => {
      cursor.style.transform = `translate(${e.clientX}px, ${e.clientY}px)`;
    });

    // Hide cursor when leaving window
    document.addEventListener('mouseleave', () => {
      cursor.style.opacity = '0';
    });

    document.addEventListener('mouseenter', () => {
      cursor.style.opacity = '1';
    });

    // Custom cursor text elements (project cards and other hover elements)
    const cursorTextElements = document.querySelectorAll('[data-cursor-text]');
    
    cursorTextElements.forEach((el) => {
      el.addEventListener('mouseenter', () => {
        cursor.classList.add('hovering');
        if (cursorText) {
          cursorText.textContent = el.getAttribute('data-cursor-text') || 'VIEW PROJECT';
        }
      });

      el.addEventListener('mouseleave', () => {
        cursor.classList.remove('hovering');
      });
    });
  }
</script>
