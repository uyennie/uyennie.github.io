---
const images = [
  '/images/trail/3d-scan.png',
  '/images/trail/cctv.png',
  '/images/trail/cd.png',
  '/images/trail/uyen-dien.png',
  '/images/trail/sparkle.gif',
  '/images/trail/zine.png',
];
---

<div class="image-trail-container" id="image-trail-container"></div>

<script define:vars={{ images }}>
  const container = document.getElementById('image-trail-container');
  let isDragging = false;
  let lastX = 0;
  let lastY = 0;
  const distanceThreshold = 100;
  let currentImageIndex = 0;

  document.addEventListener('mousedown', function(event) {
    isDragging = true;
    lastX = event.clientX;
    lastY = event.clientY;
  });

  document.addEventListener('mouseup', function() {
    isDragging = false;
  });

  document.addEventListener('mousemove', function(event) {
    if (!isDragging) return;

    const deltaX = event.clientX - lastX;
    const deltaY = event.clientY - lastY;
    const distance = Math.sqrt(deltaX * deltaX + deltaY * deltaY);

    if (distance >= distanceThreshold) {
      addImage(event.clientX, event.clientY);
      lastX = event.clientX;
      lastY = event.clientY;
    }
  });

  function addImage(x, y) {
    const img = document.createElement('img');
    img.classList.add('trail-image');
    img.src = images[currentImageIndex];
    currentImageIndex = (currentImageIndex + 1) % images.length;

    const randomOffsetX = Math.floor(Math.random() * 20) - 10;
    const randomOffsetY = Math.floor(Math.random() * 20) - 10;
    const randomRotation = Math.floor(Math.random() * 20) - 10;
    
    img.style.left = `${x - 100 + randomOffsetX}px`;
    img.style.top = `${y - 100 + randomOffsetY}px`;
    img.style.transform = `rotate(${randomRotation}deg)`;
    
    container.appendChild(img);

    // Trigger animation
    requestAnimationFrame(() => {
      img.classList.add('animate');
    });

    // Remove after animation completes
    setTimeout(() => {
      if (img.parentNode) {
        container.removeChild(img);
      }
    }, 1000);
  }
</script>

<style>
  .image-trail-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 9998;
    overflow: visible;
  }

  .image-trail-container :global(.trail-image) {
    position: absolute;
    max-width: 200px;
    max-height: 200px;
    width: auto;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    opacity: 0;
  }

  .image-trail-container :global(.trail-image.animate) {
    animation: showThenFade 1s ease-out forwards;
  }

  @keyframes showThenFade {
    0% {
      opacity: 0;
    }
    10% {
      opacity: 1;
    }
    50% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
</style>
