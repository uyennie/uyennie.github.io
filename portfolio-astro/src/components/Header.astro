---
const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Other Works', href: '/other-works' },
  { label: 'Resume', href: '/resume.pdf' },
];
---

<header class="header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="logo">
        <span class="name">UYEN DIEN</span>
        <span class="title">DESIGNER + CREATIVE TECHNOLOGIST</span>
      </a>
    </div>
    <nav class="header-nav">
      {navItems.map((item) => (
        <a href={item.href} class="nav-pill">{item.label}</a>
      ))}
    </nav>
  </div>
</header>

<style>
  .header {
    position: relative;
    z-index: 100;
    padding: var(--spacing-md) var(--page-margin);
    background: transparent;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .name {
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .title {
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #888888;
  }

  .header-nav {
    display: flex;
    gap: 0;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: #484848;
    background: #15FC00;
    padding: 8px 14px;
    border-radius: 9999px;
    transition: background 0.3s ease;
  }

  .nav-pill:hover {
    background: #DADADA;
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      gap: var(--spacing-sm);
    }

    .logo {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
