---
const navItems = [
  { label: 'About', href: '/about' },
  { label: 'Other Works', href: '/other-works' },
  { label: 'Resume', href: '/resume.pdf' },
];
---

<header class="header">
  <div class="header-inner">
    <div class="header-left">
      <a href="/" class="logo">
        <span class="name">UYEN DIEN</span>
        <span class="title">DESIGNER + CREATIVE TECHNOLOGIST</span>
      </a>
    </div>
    <nav class="header-nav desktop-nav">
      {navItems.map((item) => (
        <a href={item.href} class="nav-pill">{item.label}</a>
      ))}
    </nav>
    <button class="menu-toggle" id="menu-toggle" aria-label="Toggle menu">
      <span class="menu-icon"></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobile-nav">
    {navItems.map((item) => (
      <a href={item.href} class="nav-pill">{item.label}</a>
    ))}
  </nav>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  
  menuToggle?.addEventListener('click', () => {
    menuToggle.classList.toggle('active');
    mobileNav?.classList.toggle('open');
  });
</script>

<style>
  .header {
    position: relative;
    z-index: 100;
    padding: var(--spacing-md) var(--page-margin);
    background: transparent;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .header-left {
    display: flex;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--color-text);
  }

  .name {
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .title {
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: #888888;
  }

  .desktop-nav {
    display: flex;
    gap: 0;
  }

  .nav-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: nowrap;
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    color: #484848;
    background: #15FC00;
    padding: 8px 14px;
    border-radius: 9999px;
    transition: background 0.3s ease;
  }

  .nav-pill:hover {
    background: #DADADA;
  }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #15FC00;
    border: none;
    cursor: pointer;
    position: relative;
    transition: background 0.3s ease;
  }

  .menu-toggle:hover {
    background: #DADADA;
  }

  .menu-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 16px;
    height: 2px;
    background: #484848;
    transition: all 0.3s ease;
  }

  .menu-icon::before,
  .menu-icon::after {
    content: '';
    position: absolute;
    left: 0;
    width: 16px;
    height: 2px;
    background: #484848;
    transition: all 0.3s ease;
  }

  .menu-icon::before {
    top: -5px;
  }

  .menu-icon::after {
    top: 5px;
  }

  .menu-toggle.active .menu-icon {
    background: transparent;
  }

  .menu-toggle.active .menu-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle.active .menu-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 0;
    margin: 0 var(--page-margin) 0;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: #15FC00;
    border-radius: var(--radius-lg);
    overflow: hidden;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .mobile-nav.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .mobile-nav .nav-pill {
    background: transparent;
    border-radius: 0;
    padding: 14px 16px;
    justify-content: flex-start;
  }

  .mobile-nav .nav-pill:hover {
    background: #DADADA;
  }

  @media (max-width: 768px) {
    .desktop-nav {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .title {
      display: none;
    }
  }
</style>
