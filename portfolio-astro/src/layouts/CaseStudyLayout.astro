---
import BaseLayout from './BaseLayout.astro';
import CaseStudyNav from '../components/CaseStudyNav.astro';
import ProjectMeta from '../components/ProjectMeta.astro';

interface Props {
  frontmatter: {
    title: string;
    company: string;
    status: string;
    year: string;
    heroImage: string;
    role: string;
    timeline: string;
    team: string[];
    skills: string[];
    sections: { id: string; label: string }[];
  };
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={`${frontmatter.title} — Uyen Dien`}>
  <div class="case-study">
    <div class="case-study-layout">
      <CaseStudyNav sections={frontmatter.sections} />
      
      <article class="case-study-content">
        <header class="case-study-header">
          <div class="project-tag">
            <span class="company">{frontmatter.company}</span>
            <span class="separator">•</span>
            <span class="status">{frontmatter.status} {frontmatter.year}</span>
          </div>
          <h1 class="project-title">{frontmatter.title}</h1>
        </header>

        <div class="hero-image">
          {frontmatter.heroImage.endsWith('.mp4') || frontmatter.heroImage.endsWith('.mov') || frontmatter.heroImage.endsWith('.webm') ? (
            <video src={frontmatter.heroImage} autoplay loop muted playsinline />
          ) : (
            <img src={frontmatter.heroImage} alt={frontmatter.title} />
          )}
        </div>

        <ProjectMeta 
          role={frontmatter.role}
          timeline={frontmatter.timeline}
          team={frontmatter.team}
          skills={frontmatter.skills}
        />

        <div class="prose">
          <slot />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .case-study {
    padding: var(--spacing-xl) var(--page-margin);
  }

  .case-study-layout {
    display: grid;
    grid-template-columns: 180px 1fr 180px;
    gap: 24px;
    max-width: 100%;
  }

  .case-study-content {
    max-width: 680px;
    margin: 0 auto;
  }

  .case-study-header {
    margin-bottom: var(--spacing-lg);
  }

  .project-tag {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-sm);
  }

  .separator {
    opacity: 0.5;
  }

  .project-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    line-height: 1.1;
    text-wrap: balance;
  }

  .hero-image {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface);
    margin-bottom: var(--spacing-lg);
  }

  .hero-image img,
  .hero-image video {
    width: 100%;
    height: auto;
  }

  /* Prose styles for MDX content */
  .prose {
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .prose :global(h2) {
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-top: var(--spacing-2xl);
    margin-bottom: var(--spacing-md);
  }

  .prose :global(h3) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
  }

  .prose :global(p) {
    margin-bottom: var(--spacing-md);
  }

  .prose :global(img),
  .prose :global(video) {
    border-radius: var(--radius-md);
    margin: var(--spacing-sm) 0;
  }

  .prose :global(.image-row) {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    margin: var(--spacing-sm) 0;
  }

  .prose :global(.image-row img),
  .prose :global(.image-row video) {
    margin: 0;
    height: 300px;
    width: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
  }

  .prose :global(.image-stack) {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
    flex: 1;
  }

  .prose :global(.image-stack img) {
    margin: 0;
    width: 100%;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--spacing-md);
    padding-left: var(--spacing-xl);
  }

  .prose :global(li) {
    margin-bottom: var(--spacing-xs);
  }

  .prose :global(.external-link) {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px dotted transparent;
    transition: border-color 0.3s ease;
    padding-bottom: 2px;
  }

  .prose :global(.external-link:hover) {
    border-color: #888888;
  }

  .prose :global(blockquote) {
    border-left: 3px solid var(--color-border);
    padding-left: var(--spacing-md);
    margin: var(--spacing-lg) 0;
    font-style: italic;
    color: var(--color-text-secondary);
  }

  @media (max-width: 1024px) {
    .case-study-layout {
      grid-template-columns: 1fr;
    }

    .case-study-content {
      max-width: 100%;
    }
  }
</style>
