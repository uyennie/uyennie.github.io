---
import '../styles/global.css';
import Header from '../components/Header.astro';
import CustomCursor from '../components/CustomCursor.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Uyen Dien — Artist, Designer, Researcher, Educator" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" href="https://em-content.zobj.net/thumbs/240/apple/354/globe-showing-asia-australia_1f30f.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body>
    <CustomCursor />
    <Header />
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  main {
    min-height: calc(100vh - 80px);
    position: relative;
  }
</style>
