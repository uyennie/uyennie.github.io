---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ImageTrail from '../components/ImageTrail.astro';

const projects = [
  {
    title: "World Models",
    company: "Canva",
    status: "Shipped 2025",
    image: "/images/content/content-1.gif",
    href: "/work/world-models",
    description: "A World Model is an AI system that generates visual reality in real time. Frame by frame, at the speed of human perception.",
    featured: true
  },
  {
    title: "Content Overload",
    company: "Personal",
    status: "2022",
    image: "/images/content/content-1.gif",
    href: "/work/content-overload",
    description: "A microsite exploring information overload in social media spaces using machine learning."
  },
  {
    title: "Future Record",
    company: "Personal",
    status: "2022",
    image: "/images/future-record/future-record-2.jpg",
    href: "/work/future-record",
    description: "Visualizing digital waste as 3D objects with size and mass."
  },
  {
    title: "Scopri",
    company: "Personal",
    status: "2023",
    image: "/images/scopri/11.jpg",
    href: "/work/scopri",
    description: "Brand identity for a modern Italian pasta bar."
  },
  {
    title: "Deus Ex Machina",
    company: "Personal",
    status: "2022",
    image: "/images/deus-ex-machina/deus-ex-1.jpg",
    href: "/work/deus-ex-machina",
    description: "A microsite reimagining relationships between reader, text, and author."
  },
  {
    title: "Digital Self",
    company: "Personal",
    status: "2022",
    image: "/images/digital-self/digital-self-4.jpg",
    href: "/work/digital-self",
    description: "An essay and collection of articles on digital selfhood."
  }
];
---

<BaseLayout title="Uyen Dien — Portfolio">
  <ImageTrail />
  <section class="hero">
    <p class="intro">
      Uyen Dien <span class="pronouns pill">they/them</span> is an artist, designer, researcher, and educator.
    </p>
  </section>

  <section class="projects">
    <div class="projects-grid">
      <div class="column">
        {projects.filter((_, i) => i % 2 === 0).map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
      <div class="column">
        {projects.filter((_, i) => i % 2 === 1).map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 120px 32px var(--spacing-xl) 32px;
  }

  .intro {
    font-size: clamp(1.5rem, 4vw, 2.25rem);
    line-height: 1.3;
    max-width: 600px;
    font-weight: 400;
    margin: 0;
  }

  .pronouns {
    font-size: 0.9rem;
    vertical-align: middle;
    margin: 0 0.25rem;
  }

  .projects {
    padding: 0 32px var(--spacing-2xl) 32px;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (max-width: 900px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
