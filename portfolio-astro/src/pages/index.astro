---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ImageTrail from '../components/ImageTrail.astro';

const projects = [
  {
    title: "Transforming the Performance Tool",
    company: "Million",
    status: "Shipped 2024",
    image: "/images/million/million-intro.gif",
    href: "/work/world-models",
    description: "A World Model is an AI system that generates visual reality in real time. Frame by frame, at the speed of human perception.",
    featured: true
  },
  {
    title: "Canva Video 2.0 Launch",
    company: "Canva",
    status: "Shipped 2025",
    video: "/images/canva-video/DROP25015_ProductHypeReel_CanvaVideo_Desktop.mp4",
    href: "/work/canva-video",
    cursorText: "VIEW PRODUCT ROLLOUT",
    description: "A microsite exploring information overload in social media spaces using machine learning."
  },
  {
    title: "Canva Strategic Brand Partnerships",
    company: "Canva X Disney",
    status: "Shipped 2025",
    image: "/images/canva-partnerships/partnerships-intro.png",
    href: "/work/design-like-a-hero",
    cursorText: "VIEW CAMPAIGN",
    description: ""
  },
  {
    title: "From Functional to Premium Finance",
    company: "Primary",
    status: "Rebranded 2025",
    video: "/images/primary/primary-intro.mp4",
    href: "/work/primary",
    description: "A microsite reimagining relationships between reader, text, and author."
  },
  {
    title: "Making Founder Burnout Unmissable",
    company: "Superpower",
    status: "Shipped 2025",
    video: "/images/tfhc/tfhc-intro.mp4",
    href: "/work/future-record",
    description: "Visualizing digital waste as 3D objects with size and mass."
  },
  {
    title: "Rebranding the AI Learning Experience",
    company: "Build Club",
    status: "Shipped 2024",
    video: "/images/buildclub/bc-intro.mp4",
    href: "/work/buildclub",
    description: ""
  },
  {
    title: "Modern Identity for Classic Italian",
    company: "Scopri",
    status: "Rebranded 2024",
    image: "/images/scopri/scopri-cover.png",
    href: "/work/scopri",
    cursorText: "VIEW BRANDING",
    description: "Brand identity for a modern Italian pasta bar."
  },
  {
    title: "Rethinking Our Relationship with Technology",
    company: "Personal",
    status: "2022",
    image: "/images/digital-self/digital-self-1.JPG",
    href: "/work/digital-self",
    cursorText: "VIEW PUBLICATION",
    description: "An essay and collection of articles on digital selfhood."
  }
];
---

<BaseLayout title="Uyen Dien — Portfolio">
  <ImageTrail />
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-left">
        <p class="intro">
          I'm <span class="name-hover" data-cursor-text="THEY/THEM">Uyen</span>, a <span class="word-hover" data-image="/images/designer.jpg">designer</span>, <span class="word-hover" data-image="/images/computer.gif">coder</span> <br class="desktop-break" />and part-time <span class="word-hover" data-image="/images/grasshopper.png">tattooer</span>.
        </p>
      </div>
      <div class="hero-right">
        <div class="experience-list">
          <div class="experience-item">
            <span class="exp-label">Currently</span>
            <span class="exp-text">design engineering at <a href="https://www.lowercase.club/" target="_blank" rel="noopener noreferrer" class="exp-company">lowercase</a></span>
            <img src="/images/lowercase_club_logo.jpeg" alt="lowercase" class="exp-logo" />
          </div>
          <div class="experience-item">
            <span class="exp-label">Previously</span>
            <span class="exp-text">at <a href="https://canva.com" target="_blank" rel="noopener noreferrer" class="exp-company">Canva</a></span>
            <img src="/images/canva.png" alt="Canva" class="exp-logo" />
          </div>
        </div>
      </div>
    </div>
    <div class="hover-image" id="hover-image">
      <img src="" alt="" />
    </div>
  </section>

  <section class="projects">
    <div class="projects-grid">
      <div class="column">
        {projects.filter((_, i) => i % 2 === 0).map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
      <div class="column">
        {projects.filter((_, i) => i % 2 === 1).map((project) => (
          <ProjectCard {...project} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 260px var(--page-margin) var(--spacing-xl) var(--page-margin);
    position: relative;
    user-select: none;
  }

  .projects {
    user-select: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: end;
  }

  .hero-left {
    display: flex;
    flex-direction: column;
  }

  .hero-right {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
  }

  .intro {
    font-size: 2.8rem;
    line-height: 1.1;
    font-weight: 600;
    margin: 0;
    text-wrap: balance;
  }

  @media (min-width: 1920px) {
    .intro {
      font-size: 3.5rem;
    }
  }

  @media (min-width: 2400px) {
    .intro {
      font-size: 3.8rem;
    }
  }

  .name-hover {
    cursor: none;
  }

  .word-hover {
    cursor: none;
    position: relative;
  }

  .desktop-break {
    display: block;
  }

  .experience-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .experience-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.3rem;
    line-height: 0.8;
    flex-wrap: wrap;
  }

  .exp-label {
    color: #888888;
  }

  .exp-text {
    color: var(--color-text);
  }

  .exp-company {
    color: var(--color-text);
    text-decoration: none;
    border-bottom: 2px dotted transparent;
    transition: border-color 0.3s ease;
    padding-bottom: 2px;
  }

  .exp-company:hover {
    border-color: #888888;
  }

  .exp-logo {
    height: 26px;
    width: auto;
    object-fit: contain;
    border-radius: 4px;
  }

  .hover-image {
    position: fixed;
    pointer-events: none;
    z-index: 1000;
    opacity: 0;
    transform: scale(0.8);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .hover-image.visible {
    opacity: 1;
    transform: scale(1);
  }

  .hover-image img {
    max-width: 300px;
    max-height: 300px;
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: 8px;
  }

  .projects {
    padding: 0 var(--page-margin) var(--spacing-2xl) var(--page-margin);
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  @media (max-width: 1250px) {
    .desktop-break {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .hero {
      padding-top: 40px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const hoverImage = document.getElementById('hover-image');
  const hoverImg = hoverImage?.querySelector('img');
  const wordHovers = document.querySelectorAll('.word-hover');

  wordHovers.forEach(word => {
    word.addEventListener('mouseenter', (e) => {
      const imageSrc = word.getAttribute('data-image');
      if (hoverImg && imageSrc) {
        hoverImg.src = imageSrc;
        if (hoverImage) {
          hoverImage.style.left = `${e.clientX - 120}px`;
          hoverImage.style.top = `${e.clientY - 250}px`;
        }
        hoverImage?.classList.add('visible');
      }
    });

    word.addEventListener('mousemove', (e) => {
      if (hoverImage) {
        hoverImage.style.left = `${e.clientX - 120}px`;
        hoverImage.style.top = `${e.clientY - 250}px`;
      }
    });

    word.addEventListener('mouseleave', () => {
      hoverImage?.classList.remove('visible');
    });
  });
</script>
