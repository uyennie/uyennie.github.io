---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Uyen Dien">
  <section class="about">
    <div class="about-grid">
      <div class="about-content">
        <h1>About</h1>
        <p class="intro">
          I'm Uyen Dien, a multidisciplinary designer currently based in Naarm (Melbourne, AUS).
        </p>
        <p>
          I enjoy working with a range of projects including (but not limited to) web design, 
          publications, illustrations and 3D technical art. My work often explores the intersection 
          of technology, culture, and human experience.
        </p>
        <p>
          I believe in design that is thoughtful, purposeful, and considers its broader impact 
          on people and systems.
        </p>

        <div class="education">
          <h2>Education</h2>
          <p>
            <strong>Monash University, 2023</strong><br />
            → Bachelor of Communication Design<br />
            → Bachelor of Information Technology
          </p>
        </div>

        <div class="contact">
          <h2>Get in Touch</h2>
          <ul>
            <li><a href="mailto:dienuyenh@gmail.com">dienuyenh@gmail.com</a></li>
            <li><a href="https://www.instagram.com/uyen.world/" target="_blank">Instagram @uyen.world</a></li>
            <li><a href="https://www.linkedin.com/in/uyendien/" target="_blank">LinkedIn</a></li>
          </ul>
        </div>
      </div>
      <div class="about-image">
        <img src="/images/about/me.jpg" alt="Uyen Dien" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    padding: var(--spacing-2xl) var(--page-margin);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-2xl);
    align-items: start;
  }

  .about-content h1 {
    font-size: 2.8rem;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: var(--spacing-lg);
    text-wrap: balance;
  }

  .intro {
    font-size: 1.25rem;
    line-height: 1.5;
    margin-bottom: var(--spacing-md);
    text-wrap: balance;
  }

  .about-content p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .education,
  .contact {
    margin-top: var(--spacing-xl);
  }

  .education h2,
  .contact h2 {
    font-family: 'SF Mono', SFMono-Regular, ui-monospace, Menlo, Monaco, 'Cascadia Code', 'Consolas', monospace;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-sm);
  }

  .contact ul {
    list-style: none;
    padding: 0;
  }

  .contact li {
    margin-bottom: var(--spacing-xs);
  }

  .contact a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .contact a:hover {
    color: var(--color-text-secondary);
  }

  .about-image {
    display: flex;
    justify-content: flex-end;
    align-items: flex-start;
  }

  .about-image img {
    width: 60%;
    height: auto;
    border-radius: var(--radius-lg);
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-image {
      justify-content: center;
      order: -1;
    }

    .about-image img {
      width: 80%;
    }
  }
</style>
