---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const works = [
  {
    title: "Non-Binary",
    company: "Personal",
    status: "2022",
    image: "/images/other/non-binary.jpg",
    cursorText: "POSTER"
  },
  {
    title: "Frost",
    company: "Personal",
    status: "2021",
    image: "/images/other/frost-2.jpg",
    cursorText: "3D"
  },
  {
    title: "DiSoRiEnT Video",
    company: "Personal",
    status: "2021",
    video: "/images/other/disorient-video.mp4",
    cursorText: "AR/VR"
  },
  {
    title: "In Your Hands",
    company: "Personal",
    status: "2022",
    image: "/images/other/in-your-hands-1.gif",
    cursorText: "ILLUSTRATION/PUBLICATION"
  },
  {
    title: "DiSoRiEnT",
    company: "Personal",
    status: "2021",
    image: "/images/other/disorient-6.gif",
    cursorText: "PUBLICATION"
  },

];
---

<BaseLayout title="Other Works — Uyen Dien">
  <section class="works">
    <header class="works-header">
      <h1>Other Works</h1>
      <p>A collection of personal projects, experiments, and explorations.</p>
    </header>

    <div class="works-grid">
      {works.map((work) => (
        <ProjectCard {...work} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .works {
    padding: var(--spacing-xl) var(--page-margin) var(--spacing-2xl) var(--page-margin);
  }

  .works-header {
    margin-bottom: var(--spacing-xl);
  }

  .works-header h1 {
    font-size: 2.8rem;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: var(--spacing-sm);
    text-wrap: balance;
  }

  .works-header p {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
  }

  .works-grid {
    columns: 3;
    column-gap: 24px;
  }

  .works-grid :global(.project-card) {
    break-inside: avoid;
    margin-bottom: 24px;
  }

  @media (max-width: 1024px) {
    .works-grid {
      columns: 2;
    }
  }

  @media (max-width: 640px) {
    .works-grid {
      columns: 1;
    }
  }
</style>
